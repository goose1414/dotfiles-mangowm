# Font
font=JetBrainsMono Nerd Font 12

# Colors (Catppuccin Mocha)
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #45475a

# Shape (matches mango: 2px borders, 10px gaps)
border-size=2
border-radius=0
padding=12
margin=10

# Layout
anchor=top-right
layer=overlay
width=350
height=150
max-visible=5

# Behavior
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
icon-path=/usr/share/icons/breeze-dark
format=<b>%s</b>\n%b

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=normal]
border-color=#89b4fa

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
