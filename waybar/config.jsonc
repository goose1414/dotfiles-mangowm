{
  "layer": "top",
  "position": "top",
  "height": 32,
  "exclusive": true,
  "reload_style_on_change": true,

  "modules-left": ["mango/workspaces"],
  "modules-center": ["mango/window"],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "clock"
  ],

  "mango/workspaces": {
    "tooltip": false
  },
  "mango/window": {
    "format": "{title}",
    "max-length": 50,
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid} ({ipaddr})"
  },

  "cpu": {
    "interval": 5,
    "format": "cpu {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "mem {used:0.1f}G",
    "tooltip-format": "Used {used:0.1f}G / {total:0.1f}G"
  },

  "battery": {
    "interval": 30,
    "states": { "warning": 20, "critical": 8 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  }
}
